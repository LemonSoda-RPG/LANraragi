# Optional runtime paths for the Homebrew LANraragi launcher.
# Copy this file to ~/.config/lanraragi/lanraragi.env and edit paths as needed.
#
# Changes here only require a service restart:
#   brew services restart jiacheng/lanraragi-local/lanraragi

# Archive/content directory.
# export LRR_DATA_DIRECTORY="${HOME}/Library/Application Support/LANraragi/content"

# Thumbnail cache directory.
# export LRR_THUMB_DIRECTORY="${HOME}/Library/Application Support/LANraragi/content/thumb"

# Redis database directory.
# export LRR_DATABASE_DIRECTORY="${HOME}/Library/Application Support/LANraragi/database"

# Application log directory.
# export LRR_LOG_DIRECTORY="${HOME}/Library/Logs/LANraragi"

# Temporary files and pid files.
# export LRR_TEMP_DIRECTORY="${HOME}/Library/Application Support/LANraragi/temp"
